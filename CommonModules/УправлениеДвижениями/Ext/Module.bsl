// Записывает движение регистра
Процедура ЗаписатьДвиженияТоваров(НаборДвижений, ВидДвижения, Период, Склад, Товары) Экспорт

    НаборДвижений.ТоварыНаСкладах.Записывать = Истина;

    Для Каждого СтрокаТовара Из Товары Цикл
        Движение = НаборДвижений.ТоварыНаСкладах.Добавить();
        Движение.ВидДвижения = ВидДвижения;
        Движение.Период = Период;
        Движение.Номенклатура = СтрокаТовара.Номенклатура;
        Движение.Склад = Склад;
        Движение.Количество = СтрокаТовара.Количество;
    КонецЦикла;

    НаборДвижений.Записать();

КонецПроцедуры