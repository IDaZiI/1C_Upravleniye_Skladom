// Проверка на допустимость даты
Функция ДатаДопустима(Дата) Экспорт

    НачалоДиапазона = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -1);
    КонецДиапазона = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), 1);

    Возврат НачалоДня(Дата) >= НачалоДиапазона И НачалоДня(Дата) <= КонецДиапазона;

КонецФункции          

// Проверка на заполненность склада (указан ли он вообще)
Функция СкладЗаполнен(Склад) Экспорт
	
	Возврат ЗначениеЗаполнено(Склад);
	
КонецФункции                 

// Проверка, что таблица не пустая
Функция ТаблицаЗаполнена(Товары) Экспорт
	
	Возврат Товары.Количество() > 0;
	
КонецФункции                

// Номер первой строки с ошибкой заполнения или 0
Функция ПерваяСтрокаСНекорректнойНоменклатурой(Товары) Экспорт

    НомерСтроки = 0;
    Для Каждого СтрокаТовара Из Товары Цикл
        НомерСтроки = НомерСтроки + 1;
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
            Возврат НомерСтроки;
        КонецЕсли;
    КонецЦикла;

    Возврат 0;

КонецФункции 

// Номер первой строки с ошибкой цены или 0
Функция ПерваяСтрокаСНекорректнымКоличеством(Товары) Экспорт
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовара из Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		Если Не ЗначениеЗаполнено(СтрокаТовара.Количество) Или СтрокаТовара.Количество <= 0 Тогда
			Возврат НомерСтроки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

// Номер первой строки с ошибкой цены или 0
Функция ПерваяСтрокаСНекорректнойЦеной(Товары) Экспорт
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовара из Товары Цикл
		НомерСтроки = НомерСтроки + 1;
		Если СтрокаТовара.Цена <= 0 Тогда
			Возврат НомерСтроки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции 

// Возращает структуру с ошибками
Функция ОшибкаЗаполненияСтруктура(Дата, Склад, Товары, ЭтоПоступление = Ложь) Экспорт

    Если Не ДатаДопустима(Дата) Тогда
        Возврат Новый Структура("Текст, Поле",
            "Дата документа вне допустимого диапазона.", "Дата");
    КонецЕсли;

    Если Не СкладЗаполнен(Склад) Тогда
        Возврат Новый Структура("Текст, Поле", 
			"Склад не указан.", "Склад");
    КонецЕсли;

    Если Не ТаблицаЗаполнена(Товары) Тогда
        Возврат Новый Структура("Текст, Поле",
			"Товары не указаны.", "Товары");
    КонецЕсли;

    НомерНевернойНомеклатуры = ПерваяСтрокаСНекорректнойНоменклатурой(Товары);
	Если НомерНевернойНомеклатуры > 0 Тогда 
		ИдСтроки = Товары[НомерНевернойНомеклатуры - 1].ПолучитьИдентификатор();
		Возврат Новый Структура("Текст, Поле, Строка",
            "Строка " + НомерНевернойНомеклатуры + ": заполните номенклатуру.",
            "ТоварыНоменклатура", НомерНевернойНомеклатуры);
	КонецЕсли;
	
	НомерНеверногоКоличества = ПерваяСтрокаСНекорректнымКоличеством(Товары);
    Если НомерНеверногоКоличества > 0 Тогда
        Возврат Новый Структура("Текст, Поле, Строка",
            "Строка " + НомерНеверногоКоличества + ": количество должно быть больше нуля.",
            "ТоварыКоличество", НомерНеверногоКоличества);
	КонецЕсли;

    Если ЭтоПоступление Тогда
        НомерНевернойЦены = ПерваяСтрокаСНекорректнойЦеной(Товары);
        Если НомерНевернойЦены > 0 Тогда
            Возврат Новый Структура("Текст, Поле, Строка",
                "Строка " + НомерНевернойЦены + ": цена должна быть больше нуля.",
                "ТоварыЦена", НомерНевернойЦены);
        КонецЕсли;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции