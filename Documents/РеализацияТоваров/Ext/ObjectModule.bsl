Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Валидация данных
	Ошибка = ПроверкаДанныхДокументов.ТекстОшибкиЗаполнения(Дата, Склад, Товары);
	Если Ошибка <> "" Тогда
	    Сообщить(Ошибка);
	    Отказ = Истина;
	    Возврат;
	КонецЕсли;
	
	Суммы = Новый Соответствие;
	СписокТоваров = Новый Массив;

	Для Каждого СтрокаТовара Из Товары Цикл
		Текущая = Суммы.Получить(СтрокаТовара.Номенклатура);
		Если Текущая = Неопределено Тогда
			Текущая = 0;
			СписокТоваров.Добавить(СтрокаТовара.Номенклатура); // товар встретился впервые
		КонецЕсли;
		Суммы.Вставить(СтрокаТовара.Номенклатура, Текущая + СтрокаТовара.Количество);
	КонецЦикла;

	Остатки = УправлениеОстатками.ПолучитьОстатки(СписокТоваров, Склад);

	Для Каждого КлючИЗначение Из Суммы Цикл
		ОстатокНаСкладе = Остатки.Получить(КлючИЗначение.Ключ);
		Если ОстатокНаСкладе < КлючИЗначение.Значение Тогда
			Сообщить("Недостаточно товара """ + Строка(КлючИЗначение.Ключ)
					+ """ на складе. Остаток: " + Строка(ОстатокНаСкладе)
					+ ", нужно: " + Строка(КлючИЗначение.Значение));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Отказ Тогда
        Возврат;
	КонецЕсли;
	
	УправлениеДвижениями.ЗаписатьДвиженияТоваров(Движения, ВидДвиженияНакопления.Расход, Дата, Склад, Товары);

КонецПроцедуры