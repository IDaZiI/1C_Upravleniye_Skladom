Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Валидация данных
	Ошибка = ПроверкаДанныхДокументов.ОшибкаЗаполненияСтруктура(Дата, Склад, Товары, Истина);
	Если Ошибка <> Неопределено Тогда
	    Сообщить(Ошибка.Текст);
	    Отказ = Истина;
	    Возврат;
	КонецЕсли;
	
	// Записать приход в регистр накопления
	УправлениеДвижениями.ЗаписатьДвиженияТоваров(Движения, ВидДвиженияНакопления.Приход, Дата, Склад, Товары);
	
КонецПроцедуры