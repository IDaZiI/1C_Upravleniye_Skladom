&НаСервере
Функция ПроверитьНаСервере()
    Возврат ПроверкаДанныхДокументов.ОшибкаЗаполненияСтруктура(Объект.Дата, Объект.Склад, Объект.Товары);
КонецФункции      

&НаКлиенте
Процедура СброситьПодсветкуПолей() 
	
	НомерСтрокиСОшибкой = 0;
	КолонкаСОшибкой = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)     
	
	СброситьПодсветкуПолей();
	
	РезультатПроверки = ПроверитьНаСервере();
    Если РезультатПроверки = Неопределено Тогда
        Возврат;
	КонецЕсли;

	Отказ = Истина; 
	Сообщить(РезультатПроверки.Текст);   
	НомерСтроки = 0;
	КолонкаСОшибкой = РезультатПроверки.Поле;	
	Если РезультатПроверки.Свойство("Строка", НомерСтроки) Тогда
		НомерСтрокиСОшибкой = НомерСтроки;
	КонецЕсли;
		
КонецПроцедуры

